{
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "URLService",
    "SlowQueryThresholdMs": 5000,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30
  },
  "CodeGeneratorOptions": {
    "Offset": 0,
    "XorKey": 0,
    "Salt": "",
    "MinHashLength": 0
  },
  "RedisSettings": {
    "ConnectionString": "",
    "DefaultDatabase": 0,
    "InstanceName": "URLService"
  },
  "CacheTtlSettings": {
    "Normal": {
      "DistributedTtlSeconds": 600, // 10 minutes
      "LocalTtlSeconds": 120 // 2 minutes
    },
    "Hot": {
      "DistributedTtlSeconds": 1800, // 30 minutes
      "LocalTtlSeconds": 300 // 5 minutes
    },
    "Negative": {
      "DistributedTtlSeconds": 0,
      "LocalTtlSeconds": 60
    },
    "HotWindowSeconds": 60,
    "HotThreshold": 50
  },
  "CachePrewarmSettings": {
    "BatchSize": 50,
    "IntervalSeconds": 60,
    "TopN": 100
  },
  "BloomFilterSettings": {
    "Name": "UrlBloomFilter",
    "ExpectedElements": 100000,
    "ErrorRate": 0.01
  },
  "BackgroundJobSettings": {
    "BloomFilterCleanupJob": {
      "JobName": "BloomFilter Cleanup",
      "Enabled": true,
      "CronExpression": "0 2 * * *"
    },
    "DeleteExpiredUrlEntriesJob": {
      "JobName": "Expired UrlEntries Cleanup",
      "Enabled": true,
      "CronExpression": "0 2 * * *"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Wolverine": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "URLService",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "*"
}